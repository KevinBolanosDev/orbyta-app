{
  "name": "gravyx-ascenda",
  "private": true,
  "description": "Gravyx Ascenda monorepo — your ascent begins here.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.11.2 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "arch": "turbo run arch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck arch test:coverage && pnpm arch:selftest && pnpm audit",
    "prepare": "husky",
    "arch:selftest": "node tools/arch-selftest.mjs",
    "brand:export": "pnpm --filter @repo/ui brand:export"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
