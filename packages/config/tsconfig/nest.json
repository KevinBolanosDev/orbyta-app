{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Gravyx Ascenda NestJS app (ESM)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true,
    "types": ["node"]
  }
}
