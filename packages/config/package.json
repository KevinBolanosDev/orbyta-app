{
  "name": "@repo/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Vitest configuration.",
  "type": "module",
  "exports": {
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/library": "./eslint/library.js",
    "./eslint/react-native": "./eslint/react-native.js",
    "./eslint/nest": "./eslint/nest.js",
    "./vitest": {
      "types": "./vitest/base.d.ts",
      "default": "./vitest/base.js"
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "5.24.10",
    "@eslint/js": "10.0.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.1"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
