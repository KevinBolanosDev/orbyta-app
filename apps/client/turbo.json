{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "!android/**",
        "!ios/**",
        "!dist/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/ui/package.json"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!android/**",
        "!ios/**",
        "!dist/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/ui/package.json"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!android/**",
        "!ios/**",
        "!dist/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/ui/package.json"
      ]
    },
    "arch": { "inputs": ["$TURBO_DEFAULT$", "!android/**", "!ios/**", "!dist/**"] },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!android/**",
        "!ios/**",
        "!dist/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/ui/package.json"
      ]
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!android/**",
        "!ios/**",
        "!dist/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/ui/package.json"
      ]
    }
  }
}
